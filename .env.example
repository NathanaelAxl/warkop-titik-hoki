# Connection string pooler Supabase (mode TRANSACTION, port 6543)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# (Opsional) koneksi untuk migrasi: pooler mode SESSION (port 5432).
# Kalau kosong, migrasi memakai DATABASE_URL.
DIRECT_URL=""

# Rahasia untuk menandatangani cookie sesi. Isi string acak panjang (min. 32 karakter).
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-string-acak-panjang"

# PIN awal akun owner saat seed (hanya dipakai sekali oleh `npm run db:seed`)
SEED_OWNER_NAME="Owner"
SEED_OWNER_PIN="123456"
SEED_PEGAWAI_NAME="Budi"
SEED_PEGAWAI_PIN="1234"

# (Opsional) jumlah koneksi per instance server. Default 5. Isi 1 kalau memakai PGlite lokal.
DB_POOL_MAX=""
